# --- Core ---
APP_NAME=AI-ERP-Finance
ENV=dev
SECRET_KEY=change-me-in-production-please-32chars-min
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7

# --- Database ---
# Leave blank to use zero-config SQLite (./erp.db). For Postgres:
# DATABASE_URL=postgresql+psycopg2://erp:erp@localhost:5432/erp
DATABASE_URL=

# --- AI (all optional; system falls back to rule-based if unset) ---
AI_PROVIDER=auto            # auto | openai | anthropic | ollama | rules
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
AI_MODEL_OPENAI=gpt-4o-mini
AI_MODEL_ANTHROPIC=claude-sonnet-5
# Local LLM via Ollama (ollama serve; ollama pull llama3.2) — no key needed.
OLLAMA_BASE_URL=http://localhost:11434
AI_MODEL_OLLAMA=llama3.2

# --- CORS ---
CORS_ORIGINS=http://localhost:3000
